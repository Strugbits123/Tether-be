#!/bin/sh
# Block accidental commits of .env files containing real secrets.
# Template files (.env.example / .sample / .template) are safe placeholders.
staged=$(git diff --cached --name-only \
  | grep -E '(^|/)\.env(\.|$)' \
  | grep -vE '\.(example)$')
if [ -n "$staged" ]; then
  echo "ERROR: Attempted to commit a .env file. Remove it from staging:"
  echo "$staged" | sed 's/^/  git reset HEAD /'
  exit 1
fi
